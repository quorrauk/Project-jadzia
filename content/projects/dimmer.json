                  "pick": [
                    4.5,
                    6,
                    9
                  ]
                },
                "Rd": {
                  "pick": [
                    10,
                    20,
                    30,
                    40,
                    60,
                    80
                  ]
                }
              },
              "answer": "V / R * 1000",
              "derived": {
                "R": "20 + Rd"
              },
              "dp": 1
            }
          },
          "explain": {
            "1": "In series the squeezes add: 20 + {Rd} = {answer} Ω.",
            "2": "In series the squeezes add: 20 + {Rd} = {answer} Ω.",
            "3": "R_total = 20 + {Rd} = {R} Ω. I = {V} ÷ {R} = {answer} mA (after × 1000)."
          },
          "wrong": [
            {
              "expr": "20 * Rd",
              "why": "In series you add, not multiply: 20 + {Rd}."
            }
          ],
          "hints": [
            "Parts one after another: add the squeezes.",
            "Bulb 20 Ω plus dimmer {Rd} Ω.",
            "20 + {Rd}."
          ]
